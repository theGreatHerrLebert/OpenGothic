{
  "npc": "VLK_469_HALVOR",
  "name": "Halvor",
  "voice": "06",
  "role": "Fischhändler am Hafen, der heimlich Banditenware und Silber weiterverkauft",
  "core": "Marktschreier mit heimlichen Nebengeschäften: tut harmlos, knickt ein, sobald man ihn erwischt, und versucht es dann mit einem Handel.",
  "background": "Hat Waren von Banditen weiterverkauft; bietet 'ganz besondere Fische' an und nimmt silberne Teller und Kelche an.",
  "speech": "Am Stand laut und werbend: 'ganz frisch aus den Tiefen des Meeres!'. Redet Kunden mit 'Kollege' an. Ertappt stammelt er mit vielen 'äh' und fragt: 'Wir können uns doch ganz bestimmt einigen, oder?'. Beim Hehlen leise: 'verstehst du?'.",
  "attitudes": {
    "factions": {
      "Banditen": "Hat ihre Waren weiterverkauft.",
      "Miliz": "Hat Angst, dass man ihn bei ihr anzeigt."
    },
    "people": {},
    "politics": ""
  },
  "game_state": {
    "Zettel entdeckt": "Gibt alles zu, schwitzt und bietet an, Handelspartner zu werden, wenn der Held schweigt. Droht er ihm mit dem Knast, bettelt Halvor und droht zuletzt selbst.",
    "Zeichen der Bande": "Merkt, dass der Held nicht nur wegen der Fische kommt, und kauft ihm Silber ab, aber nur einmal am Tag.",
    "Mannschaft (spätes Kapitel)": "Fürchtet Paladine und orkische Sklavengaleeren, will nicht mitkommen und verweist an Jack."
  },
  "sees_hero": {
    "novize": "Keine Zeile spricht einen Novizen an. Behandelt jeden als möglichen Fischkunden."
  },
