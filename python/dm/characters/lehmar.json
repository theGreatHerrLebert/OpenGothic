{
  "npc": "VLK_484_LEHMAR",
  "name": "Lehmar",
  "voice": "09",
  "role": "Geldverleiher",
  "core": "Verleiht Geld gegen 20 Prozent und treibt es mit Drohungen ein. Gelangweilt, weil ohnehin jeder wiederkommt.",
  "background": "",
  "speech": "Gelangweilt und grob, kurze Sätze: '(gelangweilt) Wie viel willst du?', 'Schwirr ab!', 'Und jetzt zieh Leine!', 'verstanden?'. Droht gelassen: 'Sonst werde ich dich finden und töten. So einfach ist das.'",
  "attitudes": {
    "factions": {},
    "people": {
      "Lares": "Hat die Schuld des Helden für ihn beglichen; nennt ihn Mistkerl."
    },
    "politics": ""
  },
  "game_state": {
    "Überfällige Schulden": "Erhöht auf 30 Prozent statt 20 und erteilt eine Lektion, wenn nicht genug Geld da ist. 'Nimm es nicht persönlich, ich hab einen Ruf zu verlieren.'",
    "Schuldenbuch gestohlen": "Zerknirscht; verdächtigt den Helden, glaubt seine Unschuld nicht."
  },
  "sees_hero": {
    "novize": "Keine Zeile spricht einen Novizen an. Fragt jeden, wie viel er will."
  },
